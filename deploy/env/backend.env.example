# 复制到 /etc/sufe-ai/backend.env，替换占位值后执行 chmod 600。
DB_URL=jdbc:mysql://127.0.0.1:3306/sufe_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=false&useSSL=false
DB_USERNAME=sufe_app
DB_PASSWORD=CHANGE_ME
SERVER_PORT=8080
SESSION_COOKIE_SECURE=true

SUFE_FILE_STORAGE_ROOT=/srv/sufe-ai/data/files
SUFE_ARTIFACT_STORAGE_ROOT=/srv/sufe-ai/data/artifacts
WORKBUDDY_JOBS_ROOT=/srv/sufe-ai/data/workbuddy/jobs
LOG_FILE=/var/log/sufe-ai/backend.log
LOG_FILE_PATTERN=/var/log/sufe-ai/backend.%d{yyyy-MM-dd}.%i.log.gz

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
SERVER_MAX_THREADS=100
SERVER_MIN_SPARE_THREADS=10
SERVER_ACCEPT_COUNT=100
SUFE_LOG_LEVEL=INFO

# 默认关闭，只有完成供应商联调并获得用户明确确认后才能改为 true。
WORKBUDDY_ENABLED=false
WORKBUDDY_API_BASE=http://127.0.0.1:49678
WORKBUDDY_MAX_CONCURRENCY=1
LEXIANG_ENABLED=false
LEXIANG_API_BASE=https://lxapi.lexiangla.com
LEXIANG_APP_KEY=
LEXIANG_APP_SECRET=
LEXIANG_STAFF_ID=system-bot
LEXIANG_SPACE_ID=
LEXIANG_MAX_CONCURRENCY=2
